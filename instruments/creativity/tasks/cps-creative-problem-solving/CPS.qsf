ical Thinking"},"14":{"Display":"Yes - with Insight Thinking"},"15":{"Display":"No - But I felt like I knew the answer"},"20":{"Display":"No -  I felt like I didn't knew the answer"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Hard 5 check","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":9,"NextChoiceId":21,"QuestionDescription":"Did you mange to solve the riddle?","QuestionID":"QID660","QuestionText":"Did you mange to solve the riddle?","QuestionText_Unsafe":"Did you mange to solve the riddle?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}}}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID661","SecondaryAttribute":"Please Select Yes - with analytical thinking","TertiaryAttribute":null,"Payload":{"QuestionText":"Please Select Yes - with analytical thinking","DefaultChoices":false,"DataExportTag":"Attention","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please Select Yes - with analytical thinking","Choices":{"1":{"Display":"Yes - with analytical Thinking"},"2":{"Display":"Yes - with Insight Thinking"},"3":{"Display":"No - But I felt like I knew the answer"},"4":{"Display":"No -  I felt like I didn't knew the answer"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID661"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID662","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q574","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID662"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID663","SecondaryAttribute":"Thanks for your participation! This study tried to examine if generating creative questions impro...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thanks for your participation! This study tried to examine if generating creative questions improves performance on riddles. Specifically if higher level, more complex questions, which have been shown to correlate with more creative persons, improve riddle performance.<br \/>\n<br \/>\nRiddles Answers are as follows:<br \/>\n<br \/>\n1. Captain Frank Had no Hair<br \/>\n2. Josh is stealing ToolBoxes<br \/>\n3. The test is in Laura&#39;s Mother Tongue<br \/>\n4. Pedro fell from the first step of the ladder<br \/>\n5. The lake maxine walks on is frozen.<br \/>\n6. The pingpong ball is hit upwards and falls back by gravity.<br \/>\n7. The 2 tourists aren&#39;t together.<br \/>\n8. Proffesor Bumble is walking not driving.<br \/>\n9. The 2 mothers and 2 daughter are 3 people - A mother can also be a daughter to her mother.&nbsp;<br \/>\n10. The Acountant is the attorneys sister.<br \/>\n11. The younger italian is a girl.<br \/>\n12. The customer gave the cashier 2 10$ bills, which could only mean two way ticket.&nbsp;<br \/>\n13. The 2 pounds of lead were in powder form.<br \/>\n14. The room Jorge is seeing the painting in is Dark.<br \/>\n15. The seller is lying about the Cow.&nbsp;","DefaultChoices":false,"DataExportTag":"Debrief","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thanks for your participation! This study tried to examine if generating creative questions impro...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID663"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID664","SecondaryAttribute":"Becky is a college student who works part-time at Mark\u2019s Pizzeria. Mark, the owner of the restaur.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Becky is a college student who works part-time at Mark\u2019s Pizzeria. Mark, the owner of the restaurant, has treated Becky very well. He gave her a job that she needs to help pay her rent when no other business would employ her because she was arrested for shoplifting three years ago. Mark also lets Becky work around her school schedule, and has asked if she wants to be a shift manager in the summers. Becky\u2019s roommate Jim also works at the pizzeria, but Jim has been causing a lot of problems at work. He always avoids doing his job, treats customers rudely, and makes a lot of mistakes with orders. Jim recently began stealing food from the pizzeria. Two days ago the pizzeria was short-staffed, so Jim and Becky were the only employees left at closing time. Jim made 10 extra pizzas and took them home to a party he was hosting without paying for them. Becky feels like she needs to do something about Jim\u2019s behavior. However, Becky is hesitant to tell Mark about Jim because Jim is a good friend to Becky. Becky also needs Jim to have a job so he can pay his portion of their rent. Becky does not know what to do.<\/p>\n\n<p>&nbsp;<\/p><p><br><\/p><p><br><\/p>","DefaultChoices":false,"DataExportTag":"Q576","QuestionID":"QID664","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Becky is a college student who works part-time at Mark\u2019s Pizzeria. Mark, the owner of the restaur...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID665","SecondaryAttribute":"The Engineering Department of Acme Company has been holding wage increases to a 6 percent level....","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>The Engineering Department of Acme Company has been holding wage increases to a 6 percent level. The decision to hold wage increases came about from an effort to reduce product costs: Acme has been forced to raise the price of their product twice in the past year due to increased shipping costs of materials, and upper management does not feel that Acme can remain competitive if there are any future increases in the cost of their product. Unfortunately, the engineering job market in the area stands at about 12 jobs for every one trained engineer. Because of this, \"headhunters\" are cropping up and are enticing Acme's engineers with \"better\" jobs and \"better\" benefits. As of late, turnover among Acme's engineers has increased and productivity has decreased. Also, there is considerable grumbling among current engineers about Acme's policy on wage increases. Upper management feels that much of the dissatisfaction is based upon the headhunters' enticements of better opportunities in other places. The concern at Acme is to maintain a quality group of engineers at a high level of productivity. Upper management at Acme does not know how to solve this problem.<\/p><p><br><\/p><p><br>&nbsp;&nbsp;<\/p><p><\/p>","DefaultChoices":false,"DataExportTag":"Q665","QuestionID":"QID665","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The Engineering Department of Acme Company has been holding wage increases to a 6 percent level....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID666","SecondaryAttribute":"Brian graduated with an MBA three years ago and has risen through the managerial ranks quickly at...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Brian graduated with an MBA three years ago and has risen through the managerial ranks quickly at a large bank. Approximately a year ago, Brian had a position to fill in his department and hired his college friend's sister, Laura, who had just graduated from college and was in need of a good job. Brian is very close to his college friend Lance, and Lance had highly recommended his sister as a hard worker. In addition, the vice president for human resources at the bank was pleased that Brian had hired a woman for the position since 90% of the employees in Brian's department are men. Laura gets along well with other people in the department, but the quality of her work has been substandard, and she has missed several department meetings. Brian met with Laura and explained what she needed to do to improve her work, but one month after their discussion, Laura missed another meeting. Brian realizes the importance of recruiting women to work in the department and does not want to upset his friend by firing Laura, but he feels that the poor quality of her work may slow down his career progress. Brian does not know what to do.<\/p><p><br><\/p><p><br><\/p><p><br><br><\/p>\n\n<p><\/p><p><\/p>","DefaultChoices":false,"DataExportTag":"Q666","QuestionID":"QID666","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Brian graduated with an MBA three years ago and has risen through the managerial ranks quickly at...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID667","SecondaryAttribute":"Sam is a technician in a large pest control company. Each week, Sam provides pest control assessm...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Sam is a technician in a large pest control company. Each week, Sam provides pest control assessments and treatments for several dozen regular accounts in his territory and handles any \"spot jobs\" that come up if he has enough time. Sam enjoys his work because the hours are flexible and he is his own boss. In addition, the pay is commission-based and since Sam is an excellent technician, he makes good money. On the other hand, Sam believes that the work can be dangerous because it calls for lifting and carrying heavy equipment without assistance. Many technicians in the company have had shoulder and back injuries as a result of such strenuous job demands. In the past few months, Sam's family has had additional expenses that Sam's regular work load cannot cover. Sam is working harder and faster, but the depressed economy has made \"spot jobs\" scarce and has removed any hope of finding a higher paying job elsewhere. Recently, Sam was offered a \"spot job\" that would pay enough to cover several overdue bills, but would involve a great deal of highly strenuous lifting, carrying and maneuvering of equipment and supplies. Sam needs the money that this job would provide; however, he is afraid of the considerable personal risk. Sam does not know what to do.<\/p><p><br><\/p><p><br><\/p><p><br>&nbsp;&nbsp;<\/p>\n\n<p><\/p><p><\/p>","DefaultChoices":false,"DataExportTag":"Q667","QuestionID":"QID667","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Sam is a technician in a large pest control company. Each week, Sam provides pest control assessm...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID668","SecondaryAttribute":"In order to increase her job opportunities upon graduation, Joan decided to work as a research as...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>In order to increase her job opportunities upon graduation, Joan decided to work as a research assistant with a faculty member in the psychology department during her junior and senior years. Joan was not sure who to work with, so she sought advice from the head of the department, Dr. Johnson. Dr. Johnson suggested that Joan work with his good friend, Dr. Bundt, since Dr. Bundt is well known in his field, has good job contacts, and has many other students working with him. After working with Dr. Bundt for two months, Joan has realized that she is not enjoying the job. The other students working with Dr. Bundt appear to be very happy, but Joan finds that she is not interested in the research project that she was assigned to work on. In addition, she finds that she has a lot of work to do that is very time consuming, with very little guidance provided on how to do what is required. Dr. Bundt himself turns out to be unfriendly and difficult to please. Joan is not sure what to do.<\/p><p><br><\/p><p><br><\/p><p><br><br><\/p>\n\n<p><\/p><p><\/p>","DefaultChoices":false,"DataExportTag":"Q668","QuestionID":"QID668","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"In order to increase her job opportunities upon graduation, Joan decided to work as a research as...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID669","SecondaryAttribute":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful.\n\nPlease type your answer into the text box below.","DefaultChoices":false,"DataExportTag":"Q581","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":631,"InputHeight":109},"QuestionDescription":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID669"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID67","SecondaryAttribute":"Date","TertiaryAttribute":null,"Payload":{"QuestionText":"Date","DefaultChoices":false,"DataExportTag":"Q60","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText","AllowFreeResponse":"false"},"QuestionDescription":"Date","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID67"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID670","SecondaryAttribute":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Please type your answer into the text box below.","DefaultChoices":false,"DataExportTag":"Q582","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":680,"InputHeight":140},"QuestionDescription":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID670"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID671","SecondaryAttribute":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Please type your answer into the text box below.","DefaultChoices":false,"DataExportTag":"Q583","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":677,"InputHeight":163},"QuestionDescription":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID671"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID672","SecondaryAttribute":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Please type your answer into the text box below.","DefaultChoices":false,"DataExportTag":"Q584","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":654,"InputHeight":155},"QuestionDescription":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID672"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID673","SecondaryAttribute":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Please type your answer into the text box below.","DefaultChoices":false,"DataExportTag":"Q585","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":632,"InputHeight":125},"QuestionDescription":"Now, generate a CREATIVE solution to the problem. A CREATIVE solution is original and useful. Ple...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID673","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID68","SecondaryAttribute":"For this task, you'll be asked to come up with as many original and creative USES for objects as...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>For this task, you'll be asked to come up with as many original and creative USES for objects as you can. The goal is to come up with *creative uses*, which are uses that strike people as clever, unusual, interesting, uncommon, humorous, innovative, or different.<\/div><div>&nbsp;<\/div><div>You will be asked to type uses for 3 different objects.&nbsp;<\/div><div>&nbsp;<\/div><div>You will have 2 minutes to type as many creative questions for each object as you can -- just press TAB after each one.<\/div><div>&nbsp;<\/div><div>Press the arrow to begin.<\/div>","DefaultChoices":false,"DataExportTag":"Q61","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"For this task, you'll be asked to come up with as many original and creative USES for objects as...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID68","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q63","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionID":"QID70"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q63","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionID":"QID71"}},{"SurveyID":"SV_0id1vFV4F70Fklo","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}