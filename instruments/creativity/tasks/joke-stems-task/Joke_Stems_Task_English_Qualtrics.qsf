":{"ScoringCategories":[{"ID":"SC_eevYxg2KWfAX6Zf","Name":"Score","Description":""}],"ScoringCategoryGroups":[],"DefaultScoringCategory":"SC_eevYxg2KWfAX6Zf","ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"AutoScoringCategory":null}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"false","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":null,"SurveyTermination":"Redirect","Header":"","Footer":"","ProgressBarDisplay":"NoText","PartialData":"+1 hour","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SkinLibrary":"uncg","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*2014","overrides":null},"NewScoring":1,"SurveyTitle":"Online Survey Software | Qualtrics Survey Solutions","ShowExportTags":"false","CollectGeoLocation":"false","SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","PasswordProtection":"No","AnonymizeResponse":"Yes","Password":"","RefererCheck":"No","RefererURL":"http:\/\/","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":"","SurveyLinkCompletedMessageLibrary":"","ResponseSummary":"No","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=7A833961","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDataCloseAfter":"LastActivity","ActiveResponseSet":null,"InactiveMessageLibrary":"","InactiveMessage":"","AvailableLanguages":{"EN":[]},"QuestionsPerPage":"10","SpellChecked":"1","":null,"EOSMessage":null,"BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","EOSMessageLibrary":null,"PartialDeletion":null}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905708","SecondaryAttribute":"WRITING FUNNY JOKES \u00a0 We're interested in the psychology of humor, like how people come up with f..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><strong>WRITING FUNNY JOKES<\/strong><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div>We're interested in the psychology of humor, like how people come up with funny and witty ideas.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>For this task, you'll be shown the first part of a joke\u2014an everyday, humorous situation\u2014and your goal is to finish the joke by <em><strong>writing something funny<\/strong><\/em>.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>All ways of being funny are welcome. People have different senses of humor, and it's okay if your sense of humor is really \"out there.\" <em><strong>What you write can be weird, gross, silly, dorky, bizarre, ironic, high-brow, dirty-minded, offensive, random, or whatever<\/strong><\/em>, so long as you're trying to come up with something really funny.<br><\/div><\/div>","DefaultChoices":false,"DataExportTag":"Humor_Instruc_1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"WRITING FUNNY JOKES \u00a0 We're interested in the psychology of humor, like how people come up with f...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1720905708","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905709","SecondaryAttribute":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Here&#39;s a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you&#39;re trying to come up with something really funny:<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that your friend invites you over and cooks dinner&mdash;and the food is totally disgusting. Later, when describing it to another friend, you say, &ldquo;Wow, that food was so bad...&quot;<\/em><\/div>\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<br \/>\n&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"hum_food","QuestionID":"QID1720905709","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":650,"InputHeight":110},"QuestionDescription":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905710","SecondaryAttribute":"In your opinion, how funny is your ending to the joke?","TertiaryAttribute":null,"Payload":{"QuestionText":"In your opinion, how funny is your ending to the joke?","DefaultChoices":false,"DataExportTag":"sr_food","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In your opinion, how funny is your ending to the joke?","Choices":{"18":{"Display":"1. Not at all funny"},"19":{"Display":"2."},"20":{"Display":"3."},"21":{"Display":"5. Very funny"},"23":{"Display":"4."}},"ChoiceOrder":["18","19","20","23","21"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"18":"1","19":"2","20":"3","21":"5","23":"4"},"VariableNaming":{"18":"","19":"","20":"","21":"","23":""},"GradingData":[],"Language":[],"NextChoiceId":24,"NextAnswerId":1,"QuestionID":"QID1720905710"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905711","SecondaryAttribute":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you're trying to come up with something really funny: &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that your friend is raving about a new TV drama series and says you need to watch it. Later that week you start streaming it, but you can\u2019t even make it through the first episode\u2014it\u2019s just too confusing and tedious. Later on, when your friend asks, \u201cWhat did you think of the show?\u201d you say, \u201cWell, ...\u201d\u201d<br><\/em><\/div>\n\n\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<\/div>","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":650,"InputHeight":113},"QuestionDescription":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"<div>Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you're trying to come up with something really funny: &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that your friend is raving about a new TV drama series and says you need to watch it. Later that week you start streaming it, but you can\u2019t even make it through the first episode\u2014it\u2019s just too confusing and tedious. Later on, when your friend asks, \u201cWhat did you think of the show?\u201d you say, \u201cWell, ...\u201d\u201d<br><\/em><\/div>\n\n\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<\/div>","DataExportTag":"hum_tv","QuestionID":"QID1720905711"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905712","SecondaryAttribute":"In your opinion, how funny is your ending to the joke?","TertiaryAttribute":null,"Payload":{"QuestionText":"In your opinion, how funny is your ending to the joke?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In your opinion, how funny is your ending to the joke?","Choices":{"18":{"Display":"1. Not at all funny"},"19":{"Display":"2."},"20":{"Display":"3."},"21":{"Display":"4."},"22":{"Display":"5. Very funny"}},"ChoiceOrder":["18","19","20","21","22"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"18":"1","19":"2","20":"3","21":"4","22":"5"},"VariableNaming":{"18":"","19":"","20":"","21":"","22":""},"GradingData":[],"Language":[],"NextChoiceId":23,"NextAnswerId":1,"QuestionText_Unsafe":"In your opinion, how funny is your ending to the joke?","DataExportTag":"sr_tv","QuestionID":"QID1720905712"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905713","SecondaryAttribute":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you're trying to come up with something really funny: &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that one of your friends wants your opinion on how well she sings. She sings a minute or two to demonstrate her voice, and you cringe\u2014she might be the worst singer you\u2019ve ever heard. When she asks, \u201cSo, how was it?\u201d you decide to be honest, so you say, \u201cTo be honest, listening to that...\u201d<\/em><\/div>\n\n\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<\/div>","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":650,"InputHeight":113},"QuestionDescription":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<div>Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you're trying to come up with something really funny: &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that one of your friends wants your opinion on how well she sings. She sings a minute or two to demonstrate her voice, and you cringe\u2014she might be the worst singer you\u2019ve ever heard. When she asks, \u201cSo, how was it?\u201d you decide to be honest, so you say, \u201cTo be honest, listening to that...\u201d<\/em><\/div>\n\n\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<\/div>","DataExportTag":"hum_singing","QuestionID":"QID1720905713"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905714","SecondaryAttribute":"In your opinion, how funny is your ending to the joke?","TertiaryAttribute":null,"Payload":{"QuestionText":"In your opinion, how funny is your ending to the joke?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In your opinion, how funny is your ending to the joke?","Choices":{"18":{"Display":"1. Not at all funny"},"19":{"Display":"2."},"20":{"Display":"3."},"21":{"Display":"4."},"22":{"Display":"5. Very funny"}},"ChoiceOrder":["18","19","20","21","22"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":23,"NextAnswerId":1,"DefaultChoices":false,"RecodeValues":{"18":"1","19":"2","20":"3","21":"4","22":"5"},"VariableNaming":{"18":"","19":"","20":"","21":"","22":""},"GradingData":[],"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"In your opinion, how funny is your ending to the joke?","DataExportTag":"sr_singing","QuestionID":"QID1720905714"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905715","SecondaryAttribute":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you're trying to come up with something really funny: &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that a new friend is picking you up so you can go shopping. You haven\u2019t seen their car before, so when it drives up you\u2019re shocked\u2014it might be the dirtiest, messiest car you\u2019ve ever seen. When your friend smiles and says, \u201cSorry, it\u2019s a little dirty,\u201d you laugh and say, \u201cA little? Seriously, this car...\u201d<br><\/em><\/div>\n\n\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<\/div>","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":650,"InputHeight":113},"QuestionDescription":"Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"<div>Here's a set-up for a joke for you to finish. Remember, what you write can be weird, gross, silly, bizarre, random, dirty-minded, or whatever, so long as you're trying to come up with something really funny: &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><em>Imagine that a new friend is picking you up so you can go shopping. You haven\u2019t seen their car before, so when it drives up you\u2019re shocked\u2014it might be the dirtiest, messiest car you\u2019ve ever seen. When your friend smiles and says, \u201cSorry, it\u2019s a little dirty,\u201d you laugh and say, \u201cA little? Seriously, this car...\u201d<br><\/em><\/div>\n\n\n\n<div style=\"margin-left: 40px;\">&nbsp;<\/div>\n\n<div>Please finish the joke by typing something funny below!<\/div>","DataExportTag":"hum_car","QuestionID":"QID1720905715"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905716","SecondaryAttribute":"In your opinion, how funny is your ending to the joke?","TertiaryAttribute":null,"Payload":{"QuestionText":"In your opinion, how funny is your ending to the joke?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In your opinion, how funny is your ending to the joke?","Choices":{"18":{"Display":"1. Not at all funny"},"19":{"Display":"2."},"20":{"Display":"3."},"21":{"Display":"4."},"22":{"Display":"5. Very funny"}},"ChoiceOrder":["18","19","20","21","22"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"18":"1","19":"2","20":"3","21":"4","22":"5"},"VariableNaming":{"18":"","19":"","20":"","21":"","22":""},"GradingData":[],"Language":[],"NextChoiceId":23,"NextAnswerId":1,"QuestionText_Unsafe":"In your opinion, how funny is your ending to the joke?","DataExportTag":"sr_car ","QuestionID":"QID1720905716"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"SQ","PrimaryAttribute":"QID1720905721","SecondaryAttribute":"So, on the next four pages, you will see the start of a joke. The task is to come up with a funny...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<div>So, on the next four pages, you will see the start of a joke. The task is to come up with a funny ending to it, like something that your friends would find funny.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>There's no time or word limit. You can take as much time or as little time as you like, and what you write can be as short or long as you like. The important thing is to try to be funny.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>We're interested in <em><strong>your ideas<\/strong><\/em>, not something from Google, AI, or the Internet, so please come up with the ideas on your own.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Have fun with it!<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Humor_Instruc_2 ","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"So, on the next four pages, you will see the start of a joke. The task is to come up with a funny...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1720905721"}},{"SurveyID":"SV_cH0KgscKlJFzjG6","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}