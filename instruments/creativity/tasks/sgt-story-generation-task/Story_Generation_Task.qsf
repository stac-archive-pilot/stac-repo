,"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":216,"NextAnswerId":1,"QuestionID":"QID196"}},{"SurveyID":"SV_d6lI8qRaIZwoyXA","Element":"SQ","PrimaryAttribute":"QID197","SecondaryAttribute":"You will now have a 60s break. ","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now have a 60s break.&nbsp;","DefaultChoices":false,"DataExportTag":"Q197","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now have a 60s break. ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID197"}},{"SurveyID":"SV_d6lI8qRaIZwoyXA","Element":"SQ","PrimaryAttribute":"QID198","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q198","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":30,"ShowTimer":true},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":180,"NextAnswerId":1,"QuestionID":"QID198"}},{"SurveyID":"SV_d6lI8qRaIZwoyXA","Element":"SQ","PrimaryAttribute":"QID201","SecondaryAttribute":"You will now complete the product improvement task. In this task, you\u2019ll be shown everyday produc.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p data-end=\"234\" data-start=\"179\"><strong>You will now complete the product improvement task.<\/strong><\/p>\n\n<p data-end=\"331\" data-start=\"236\">In this task, you&rsquo;ll be shown everyday products and asked to suggest a way to improve each one.<\/p>\n\n<p data-end=\"642\" data-start=\"333\">Your goal is to come up with ideas that are both&nbsp;<strong data-end=\"391\" data-start=\"382\">novel<\/strong>&nbsp;(i.e., original, creative, and unexpected) and&nbsp;<strong data-end=\"449\" data-start=\"439\">useful<\/strong>&nbsp;(i.e., practical, effective, and relevant to the product). Try to think beyond obvious fixes and consider improvements that add real value or enhance the user experience in an interesting way.<\/p>\n\n<p data-end=\"838\" data-start=\"644\">You will first be shown the prompt and the name of a product.<br \/>\nYou will have <strong>3 minutes<\/strong>&nbsp;to think of as many improvement ideas as you can.<br \/>\nType your responses into the text boxes.<\/p>\n\n<p data-end=\"1040\" data-start=\"840\">You will complete <strong>2<\/strong><strong data-end=\"910\" data-start=\"895\">&nbsp;products<\/strong>&nbsp;in total.<br data-end=\"995\" data-start=\"992\" \/>\nThe full task will take about <strong>6<\/strong><strong data-end=\"1039\" data-start=\"1025\">&nbsp;minutes<\/strong>.<\/p>","DefaultChoices":false,"DataExportTag":"Q201","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now complete the product improvement task. In this task, you\u2019ll be shown everyday produc...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID201"}},{"SurveyID":"SV_d6lI8qRaIZwoyXA","Element":"SQ","PrimaryAttribute":"QID202","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q202","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[]