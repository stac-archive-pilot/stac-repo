5e2\u05dc \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea\u05db\u05dd.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<span style=\"font-size:11pt\"><span style=\"line-height:200%\"><span style=\"direction:rtl\"><span style=\"unicode-bidi:embed\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"HE\" style=\"font-size:12.0pt\"><span style=\"line-height:200%\"><span style=\"font-family:&quot;Arial&quot;,sans-serif\">\u05d0\u05e0\u05d5 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05dc\u05d1\u05d7\u05d5\u05df \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05e9\u05d0\u05dc\u05ea \u05e9\u05d0\u05dc\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05d9\u05d3\u05e2. <\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<br>\n<span style=\"font-size:11pt\"><span style=\"line-height:200%\"><span style=\"direction:rtl\"><span style=\"unicode-bidi:embed\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"HE\" style=\"font-size:12.0pt\"><span style=\"line-height:200%\"><span style=\"font-family:&quot;Arial&quot;,sans-serif\">\u05dc\u05d0 \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05d1\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d1\u05e0\u05d9\u05e1\u05d5\u05d9.&nbsp; \u05de\u05e9\u05da \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05db15-20 \u05d3\u05e7\u05d5\u05ea. \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea\u05db\u05dd \u05d4\u05d9\u05d0 \u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea\u05d9\u05ea \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05d5\u05d0\u05ea\u05dd \u05e8\u05e9\u05d0\u05d9\u05dd \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d1\u05db\u05dc \u05d6\u05de\u05df, \u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05e9\u05e8\u05e7 \u05de\u05d9 <b>\u05e9\u05d9\u05e1\u05d9\u05d9\u05dd<\/b> \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05d8\u05dc\u05d5\u05ea \u05d9\u05e7\u05d1\u05dc \u05ea\u05d2\u05de\u05d5\u05dc. \u05db\u05dc \u05d4\u05de\u05d9\u05d3\u05e2 \u05e9\u05ea\u05e9\u05ea\u05e4\u05d5 \u05d9\u05d9\u05e9\u05d0\u05e8 \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9 \u05d5\u05d9\u05e9\u05de\u05e9 \u05d0\u05da \u05d5\u05e8\u05e7 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d4\u05de\u05d7\u05e7\u05e8. \u05e6\u05d9\u05d5\u05e0\u05db\u05dd \u05d4\u05e1\u05d5\u05e4\u05d9 \u05d1\u05e7\u05d5\u05e8\u05e1 \u05d9\u05d4\u05d9\u05d4 \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9 \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05d5\u05d9\u05e9\u05de\u05e9 \u05e8\u05e7 \u05dc\u05e6\u05d5\u05e8\u05db\u05d9 \u05de\u05d7\u05e7\u05e8.&nbsp; <\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<br>\n<span style=\"font-size:11pt\"><span style=\"line-height:200%\"><span style=\"direction:rtl\"><span style=\"unicode-bidi:embed\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"HE\" style=\"font-size:12.0pt\"><span style=\"line-height:200%\"><span style=\"font-family:&quot;Arial&quot;,sans-serif\">\u05d0\u05e0\u05d0 \u05de\u05dc\u05d0\u05d5 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d1\u05e4\u05e2\u05dd \u05d0\u05d7\u05ea, \u05de\u05e8\u05d2\u05e2 \u05e9\u05ea\u05ea\u05d7\u05d9\u05dc\u05d5 \u05d4\u05e9\u05dc\u05d9\u05de\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05d7\u05dc\u05e7\u05d9\u05dd.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<br>\n<br>\n<span style=\"font-size:11pt\"><span style=\"line-height:200%\"><span style=\"direction:rtl\"><span style=\"unicode-bidi:embed\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"HE\" style=\"font-size:12.0pt\"><span style=\"line-height:200%\"><span style=\"font-family:&quot;Arial&quot;,sans-serif\">\u05d4\u05ea\u05d2\u05de\u05d5\u05dc \u05e9\u05dc\u05db\u05dd \u05e2\u05d1\u05d5\u05e8 \u05d7\u05dc\u05e7 \u05d6\u05d4 \u05d9\u05d4\u05d9\u05d4 0.5 \u05e0\u05e7' \u05e7\u05e8\u05d3\u05d9\u05d8.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><br>\n<br>\n<br>\n<span style=\"font-size:11pt\"><span style=\"line-height:200%\"><span style=\"direction:rtl\"><span style=\"unicode-bidi:embed\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"HE\" style=\"font-size:12.0pt\"><span style=\"line-height:200%\"><span style=\"font-family:&quot;Arial&quot;,sans-serif\">\u05d0\u05dd \u05d9\u05e9\u05e0\u05df \u05e9\u05d0\u05dc\u05d5\u05ea \u05d0\u05d5\u05d3\u05d5\u05ea \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d0\u05e0\u05d0 \u05e6\u05e8\u05d5 \u05e7\u05e9\u05e8 \u05d1\u05de\u05d9\u05d9\u05dc <\/span><\/span><\/span><a href=\"mailto:ccl@technion.ac.il\" style=\"color:#0563c1; text-decoration:underline\"><span dir=\"LTR\" style=\"font-size:12.0pt\"><span style=\"line-height:200%\">ccl@technion.ac.il<\/span><\/span><\/a><\/span><\/span><\/span><\/span><\/span><\/div>","QuestionText_Unsafe":"<div dir=\"rtl\">\n\u05d1\u05e8\u05d5\u05db\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05dc\u05e0\u05d9\u05e1\u05d5\u05d9.<br>\n&nbsp;\u05d0\u05e0\u05d5 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05dc\u05d1\u05d7\u05d5\u05df \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05de\u05e1\u05e4\u05e8 \u05de\u05d8\u05dc\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea.<br>\n&nbsp;\u05dc\u05d0 \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05de\u05d4\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d1\u05e0\u05d9\u05e1\u05d5\u05d9.<br>\n&nbsp;\u05de\u05e9\u05da \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05db40 \u05d3\u05e7\u05d5\u05ea. \u05d4\u05d5\u05d0 \u05de\u05d5\u05e8\u05db\u05d1 \u05de2 \u05de\u05d8\u05dc\u05d5\u05ea.<br>\n\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea\u05db\u05dd \u05d4\u05d9\u05d0 \u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea\u05d9\u05ea \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05d5\u05d0\u05ea\u05dd \u05e8\u05e9\u05d0\u05d9\u05dd \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d1\u05db\u05dc \u05d6\u05de\u05df, \u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05e9\u05e8\u05e7 \u05de\u05d9 \u05e9\u05d9\u05e1\u05d9\u05d9\u05dd \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05d8\u05dc\u05d5\u05ea \u05d9\u05e7\u05d1\u05dc \u05ea\u05d2\u05de\u05d5\u05dc.<br>\n\u05db\u05dc \u05d4\u05de\u05d9\u05d3\u05e2 \u05e9\u05ea\u05e9\u05ea\u05e4\u05d5 \u05d9\u05e9\u05d0\u05e8 \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9 \u05d5\u05d9\u05e9\u05de\u05e9 \u05d0\u05da \u05d5\u05e8\u05e7 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d4\u05de\u05d7\u05e7\u05e8.<br>\n&nbsp;\u05d0\u05e0\u05d0 \u05de\u05dc\u05d0\u05d5 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d1\u05e4\u05e2\u05dd \u05d0\u05d7\u05ea, \u05de\u05e8\u05d2\u05e2 \u05e9\u05ea\u05ea\u05d7\u05d9\u05dc\u05d5 \u05d4\u05e9\u05dc\u05d9\u05de\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05d7\u05dc\u05e7\u05d9\u05dd.<br>\n&nbsp;\u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05d0\u05e0\u05d0 \u05e4\u05e0\u05d5 \u05dc: ccl@technion.ac.il &nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>&nbsp;<\/div>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1217432538\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">\u05d1\u05e8\u05d5\u05db\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05dc\u05e0\u05d9\u05e1\u05d5\u05d9. &nbsp;\u05d0\u05e0\u05d5 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05dc\u05d1\u05d7\u05d5\u05df \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05de\u05e1\u05e4\u05e8 \u05de\u05d8\u05dc\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea. &nbsp;\u05dc\u05d0 \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05e0\u05d9...<\/span> <span class=\"LeftOpDesc\">\u05de\u05d0\u05e9\u05e8\/\u05ea<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":