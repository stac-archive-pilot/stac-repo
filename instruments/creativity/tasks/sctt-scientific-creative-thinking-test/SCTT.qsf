lick to write the question text","DefaultChoices":false,"DataExportTag":"Q251","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID334"}},{"SurveyID":"SV_eCCBTqsP30v4Rjo","Element":"SQ","PrimaryAttribute":"QID335","SecondaryAttribute":"\u05d1\u05de\u05d8\u05dc\u05d4 \u05d4\u05d1\u05d0\u05d4, \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea 20 \u05d7\u05d9\u05d3\u05d5\u05ea. \u05db\u05dc \u05d7\u05d9\u05d3\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05ea \u05de\u05e9\u05dc\u05d5\u05e9 \u05de\u05d9\u05dc\u05d9\u05dd ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"direction: rtl;\"><span style=\"font-size:19px;\">\u05d1\u05de\u05d8\u05dc\u05d4 \u05d4\u05d1\u05d0\u05d4, \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea 20 \u05d7\u05d9\u05d3\u05d5\u05ea. \u05db\u05dc \u05d7\u05d9\u05d3\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05ea \u05de\u05e9\u05dc\u05d5\u05e9 \u05de\u05d9\u05dc\u05d9\u05dd \u05e0\u05e4\u05e8\u05d3\u05d5\u05ea. \u05d0\u05ea\u05dd\/\u05df \u05de\u05ea\u05d1\u05e7\u05e9\u05d9\u05dd \u05dc\u05de\u05e6\u05d5\u05d0 \u05d0\u05ea \u05d4\u05de\u05d9\u05dc\u05d4 \u05d4\u05d9\u05d5\u05e6\u05e8\u05ea \u05e6\u05d9\u05e8\u05d5\u05e3 \u05d1\u05e2\u05dc \u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e2\u05dd \u05db\u05dc \u05d0\u05d7\u05ea \u05de\u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05d7\u05d9\u05d3\u05d4 \u05d1\u05e0\u05e4\u05e8\u05d3.<\/span><\/div><div style=\"direction: rtl;\"><span style=\"font-size:19px;\"><br><\/span><\/div>\n\n<div style=\"direction: rtl;\"><span style=\"font-size:19px;\"><b>\u05dc\u05d3\u05d5\u05d2\u05de\u05d4:<\/b><br>\n\u05e8\u05d2\u05dc&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \u05d9\u05d3 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \u05e2\u05d5\u05e8&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; _________________<br>\n\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05dc\u05d7\u05d9\u05d3\u05d4 \u05d6\u05d5 \u05d4\u05d9\u05d0 \u05d4\u05de\u05d9\u05dc\u05d4 \"<b>\u05e4\u05e9\u05d9\u05d8\u05d4<\/b>\", \u05d4\u05d9\u05d5\u05e6\u05e8\u05ea \u05e6\u05d9\u05e8\u05d5\u05e3 \u05d7\u05d3\u05e9 \u05e2\u05dd \u05db\u05dc \u05d0\u05d7\u05ea \u05de\u05d4\u05de\u05d9\u05dc\u05d9\u05dd: \u05e4\u05e9\u05d9\u05d8\u05ea \u05e8\u05d2\u05dc, \u05e4\u05e9\u05d9\u05d8\u05ea \u05d9\u05d3, \u05e4\u05e9\u05d9\u05d8\u05ea \u05e2\u05d5\u05e8.<br>\n&nbsp;<br>\n\u05d7\u05e8\u05d5\u05dd&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \u05dc\u05e4\u05d9&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \u05d8\u05d5\u05d1\u05d4&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; _________________<br>\n\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05dc\u05d7\u05d9\u05d3\u05d4 \u05d6\u05d5 \u05d4\u05d9\u05d0 \u05d4\u05de\u05d9\u05dc\u05d4 \"<b>\u05e9\u05e2\u05d4<\/b>\", \u05d4\u05d9\u05d5\u05e6\u05e8\u05ea \u05e6\u05d9\u05e8\u05d5\u05e3 \u05d7\u05d3\u05e9 \u05e2\u05dd \u05db\u05dc \u05d0\u05d7\u05ea \u05de\u05d4\u05de\u05d9\u05dc\u05d9\u05dd:<br>\n\u05e9\u05e2\u05ea \u05d7\u05e8\u05d5\u05dd, \u05dc\u05e4\u05d9 \u05e9\u05e2\u05d4, \u05d1\u05e9\u05e2\u05d4 \u05d8\u05d5\u05d1\u05d4.<\/span><\/div><div style=\"direction: rtl;\"><span style=\"font-size:19px;\"><br>\n\u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05e6\u05d9\u05e8\u05d5\u05e3, \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05dc\u05de\u05d9\u05dc\u05d4 \u05de\u05d9\u05dc\u05d9\u05d5\u05ea \u05d9\u05d7\u05e1 (\u05dc\u05d3