"SQ","PrimaryAttribute":"QID252","SecondaryAttribute":"\u05d1\u05de\u05d8\u05dc\u05d4 \u05d4\u05d1\u05d0\u05d4, \u05e2\u05dc\u05d9\u05db\u05dd \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05db\u05de\u05d4 \u05e9\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d0\u05dc\u05d5\u05ea \u05de\u05e7\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05d9\u05e6\u05d9","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: right;\"><span style=\"font-size:19px;\">\u05d1\u05de\u05d8\u05dc\u05d4 \u05d4\u05d1\u05d0\u05d4, \u05e2\u05dc\u05d9\u05db\u05dd \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05db\u05de\u05d4 \u05e9\u05d9\u05d5\u05ea\u05e8 <strong>\u05e9\u05d0\u05dc\u05d5\u05ea<\/strong> \u05de\u05e7\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 <u>\u05de\u05d5\u05e9\u05d2\u05d9 \u05de\u05d7\u05e7\u05e8<\/u><br>\n\u05e9\u05d0\u05dc\u05d5\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea \u05d4\u05df \u05e9\u05d0\u05dc\u05d5\u05ea \u05e9\u05d9\u05d9\u05d7\u05e9\u05d1\u05d5 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d0\u05e0\u05e9\u05d9\u05dd \u05db\u05e0\u05d1\u05d5\u05e0\u05d5\u05ea, \u05de\u05d9\u05d5\u05d7\u05d3\u05d5\u05ea, \u05de\u05e2\u05e0\u05d9\u05d9\u05e0\u05d5\u05ea, \u05dc\u05d0 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea, \u05de\u05e6\u05d7\u05d9\u05e7\u05d5\u05ea, \u05d7\u05d3\u05e9\u05e0\u05d9\u05d5\u05ea<br>\n\u05ea\u05ea\u05d1\u05e7\u05e9\/\u05d9 \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc <strong>\u05e9\u05d0\u05dc\u05d5\u05ea<\/strong> \u05e2\u05d1\u05d5\u05e8 2 <u>\u05de\u05d5\u05e9\u05d2\u05d9\u05dd<\/u>, \u05d5\u05dc\u05e8\u05e9\u05d5\u05ea\u05da \u05d9\u05d4\u05d9\u05d5 120 \u05e9\u05e0\u05d9\u05d5\u05ea \u05dc\u05db\u05ea\u05d5\u05d1 \u05db\u05de\u05d4 \u05e9\u05d9\u05d5\u05ea\u05e8 <strong>\u05e9\u05d0\u05dc\u05d5\u05ea&nbsp;<\/strong>\u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05d5\u05e9\u05d2<br>\n<strong>TAB \u05d0\u05d7\u05e8\u05d9 \u05db\u05dc \u05e9\u05d0\u05dc\u0