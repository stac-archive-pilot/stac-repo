{"SurveyEntry":{"SurveyID":"SV_3kDb3HBeyie4H1b","SurveyName":"5DCR","SurveyDescription":null,"SurveyOwnerID":"UR_3NJRwN4wuKUFXDL","SurveyBrandID":"technioniit","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_735J71cDyREpIK9","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2020-12-05 10:36:23","CreatorID":"UR_3NJRwN4wuKUFXDL","LastModified":"2022-08-01 00:31:21","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_3kDb3HBeyie4H1b","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","Description":"Default Question Block","ID":"BL_1ZdzC3qjGTYwtQ9","BlockElements":[{"Type":"Question","QuestionID":"QID1"}]},{"Type":"Trash","Description":"Trash \/ Unused Questions","ID":"BL_2lvCIeJPbnAxysd"},{"Type":"Standard","SubType":"","Description":"Block 1","ID":"BL_5o8oW0yw7jv9UFv","BlockElements":[{"Type":"Question","QuestionID":"QID2"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","Looping":"Static","LoopingOptions":{"Static":{"1":{"1":"I view challenging situations as an opportunity to grow and learn."},"2":{"1":"I seek out situations where it is likely that I will have to think in depth about something."},"3":{"1":"I enjoy learning about subjects that are unfamiliar to me."},"4":{"1":"I find it fascinating to learn new information."},"5":{"1":"Thinking about solutions to difficult conceptual problems can keep me awake at night."},"6":{"1":"I can spend hours on a single problem because I just can't rest without knowing the answer."},"7":{"1":"I feel frustrated if I can't figure out the solution to a problem, so I work even harder to solve it."},"8":{"1":"I work relentlessly at problems that I feel must be solved."},"9":{"1":"The smallest doubt can stop me from seeking out new experiences."},"10":{"1":"I cannot handle the stress that comes from entering uncertain situations."},"11":{"1":"3 I find it hard to explore new places when I lack confidence in my abilities."},"12":{"1":"It is difficult to concentrate when there is a possibility that I will be taken by surprise."},"13":{"1":"Risk-taking is exciting to me."},"14":{"1":"When I have free time, I want to do things that are a little scary."},"15":{"1":"Creating an adventure as I go is much more appealing than a planned adventure."},"16":{"1":"I prefer friends who are excitingly unpredictable."},"17":{"1":"I ask a lot of questions to figure out what interests other people."},"18":{"1":"When talking to someone who is excited, I am curious to find out why."},"19":{"1":"When talking to someone, I try to discover interesting details about them."},"20":{"1":"I like finding out why people behave the way they do."},"21":{"1":"When other people are having a conversation, I like to find out what about"},"22":{"1":"When around other people, I like listening to their conversations."},"23":{"1":"When people quarrel, I like to know what's going on."},"24":{"1":"I seek out information about the private lives of people in my life."}},"Randomization":"All"},"BlockVisibility":"Expanded"}}]},{"SurveyID":"SV_3kDb3HBeyie4H1b","Element":"FL","PrimaryAttribute":"Survey Flow","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Flow":[{"ID":"BL_1ZdzC3qjGTYwtQ9","Type":"Block","FlowID":"FL_2"},{"ID":"BL_5o8oW0yw7jv9UFv","Type":"Standard","FlowID":"FL_3"}],"Properties":{"Count":3},"FlowID":"FL_1","Type":"Root"}},{"SurveyID":"SV_3kDb3HBeyie4H1b","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"5130f587-1961-4045-b6e7-164aa73d9269"}},{"SurveyID":"SV_3kDb3HBeyie4H1b","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_3kD