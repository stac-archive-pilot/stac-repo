es me<\/p><p>6 \u2013 Mostly describes me<\/p><p>7 \u2013 Completely describes me<\/p>","DefaultChoices":false,"DataExportTag":"Q1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will be presented with a series of statements that people often use to describe themselves. P...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1"}},{"SurveyID":"SV_3kDb3HBeyie4H1b","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Does not describe me at all"},"2":{"Display":"Barely describes me"},"3":{"Display":"Somewhat describes me"},"4":{"Display":"Neutral"},"5":{"Display":"Generally describes me"},"6":{"Display":"Mostly describes me"},"7":{"Display":"Completely describes me"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID2"}},{"SurveyID":"SV_3kDb3HBeyie4H1b","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":false,"ID":"Survey Statistics"}}]}