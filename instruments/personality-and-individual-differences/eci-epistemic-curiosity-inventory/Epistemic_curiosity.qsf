>\n\n<p>&nbsp;<\/p>\n\n<p><font face=\"Times New Roman,Times New Roman\" size=\"3\"><font face=\"Times New Roman,Times New Roman\" size=\"3\">This inventory asks you to report your creative activities and achievements. The inventory contains eight different domains. You will be asked to answer questions for three sections of each domain. <\/font><\/font><\/p>","QuestionText_Unsafe":"<p align=\"LEFT\">&nbsp;<\/p>\n\n<p><b><font size=\"3\">General instruction<\/font><\/b><font face=\"Times New Roman,Times New Roman\" size=\"3\"><font face=\"Times New Roman,Times New Roman\" size=\"3\">: <\/font><\/font><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><font face=\"Times New Roman,Times New Roman\" size=\"3\"><font face=\"Times New Roman,Times New Roman\" size=\"3\">This inventory asks you to report your creative activities and achievements. The inventory contains eight different domains. You will be asked to answer questions for three sections of each domain. <\/font><\/font><\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_1U30Tu75n416PxI","Element":"SQ","PrimaryAttribute":"QID660","SecondaryAttribute":"I \u2013 Literature \u00a01) For each activity in the field of literature, please indicate how often you ha","TertiaryAttribute":null,"Payload":{"AnswerOrder":[1,2,3,4,5],"Answers":{"1":{"Display":"Never"},"2":{"Display":"1-2 Times"},"3":{"Display":"3-5 Times"},"4":{"Display":"5-10 Times"},"5":{"Display":"More than 10 Times"}},"ChoiceDataExportTags":false,"ChoiceOrder":[1,2,3,4,5,6],"Choices":{"1":{"Display":"Wrote a short literary work (e.g., poem, short story)"},"2":{"Display":"Wrote a long literary work (e.g., book, theatre play)"},"3":{"Display":"Wrote a newspaper article\/editorials"},"4":{"Display":"Created an original talk"},"5":{"Display":"Made up a joke"},"6":{"Display":"Wrote a blog entry"}},"Configuration":{"ChoiceColumnWidth":25,"MobileFirst":true,"QuestionDescriptionOption":"UseText","RepeatHeaders":"none","TextPosition":"